---
const links = [{ label: "home", href: "/" }, { label: "projects", href: "/projects" }, { label: "contact", href: "/contact" }];
const pathname = Astro.url.pathname;
---

<header class="relative z-10 flex h-[70px] items-center px-4 md:px-8">
  <nav class="flex gap-5" aria-label="Primary navigation">
    {links.map((link) => (
      <a
        class:list={[
          "px-2 py-[7px] text-[13px] text-[#8b8c88] transition-[color,background-color] hover:bg-white/6 hover:text-[#f0f0ed]",
          { "text-[#f0f0ed] underline decoration-[#35a7ff] underline-offset-5": pathname === link.href },
        ]}
        href={link.href}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
