---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const links = [
  { name: "github", icon: "github", url: "https://github.com/hrfarmer", accent: "#f4f4f0" },
  { name: "twitter / x", icon: "x", url: "https://x.com/aychar_bot", accent: "#f4f4f0" },
  { name: "bluesky", icon: "bluesky", url: "https://bsky.app/profile/aychar.dev", accent: "#1185fe" },
  { name: "valorant", icon: "valorant", url: "https://tracker.gg/valorant/profile/riot/Back%20On%20Track%23umm/overview?platform=pc&playlist=competitive&season=3ea2b318-423b-cf86-25da-7cbb0eefbe2d", accent: "#fa4454" },
  { name: "osu!", icon: "osu", url: "https://osu.ppy.sh/users/13473514", accent: "#ff66aa" },
];
---

<Layout>
  <main class="home-shell">
    <section class="intro-panel">
      <div class="intro-copy">
        <p class="site-name">aychar.dev<span class="accent">_</span></p>
        <p class="kicker">hey, i'm aychar</p>
        <p class="lede">
          i'm a (student) software engineer looking to get into the aerospace industry
        </p>
        <p class="supporting">
          i've worked on some <a href="/projects">cool projects</a>, go look at them :D
        </p>
        <div class="socials" aria-label="Social links">
          {links.map((link) => (
            <a class="social-link" style={`--accent: ${link.accent}`} href={link.url} target="_blank" rel="noreferrer" aria-label={link.name}>
              <Icon size={21} name={link.icon} />
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="future-panel" aria-label="Reserved for future content">
      <span class="future-label">// reserved</span>
    </section>
  </main>
</Layout>
